<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls"
                    xmlns:base="clr-namespace:Lincsolution.UI.Base.Common;assembly=Lincsolution.UI.Base">

    <Style x:Key="BasicPopupButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{Binding ButtonHeight, RelativeSource={RelativeSource AncestorType={x:Type controls:BasicPopup}}}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ButtonIdleForeground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border_Button"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border_Button" Property="Background" Value="{DynamicResource Brush.SelectedBackground}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:BasicPopup}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="OverlayBackground" Value="{DynamicResource Brush.PopupBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BasicPopup}">
                    <Grid Background="Transparent">
                        <Border Width="{TemplateBinding OverlayWidth}"
                                Height="{TemplateBinding OverlayHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding OverlayBackground}"/>

                        <Grid Width="{TemplateBinding PopupWidth}"
                              Height="{TemplateBinding PopupHeight}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{Binding AccentHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="Border_Accent"
                                    Grid.Row="0"
                                    Background="{DynamicResource Brush.StatusIdle}"
                                    BorderBrush="{DynamicResource Brush.StatusIdle}"
                                    BorderThickness="1"
                                    CornerRadius="10,10,0,0"/>

                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,0,10,10">
                                <Grid Margin="16,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="{Binding ButtonHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Image x:Name="Image_Type"
                                       Grid.Row="1"
                                       Width="40"
                                       Height="40"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{DynamicResource Icon.Info}"/>

                                <TextBlock x:Name="Text_Title"
                                           Grid.Row="3"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="{TemplateBinding TitleFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{DynamicResource String.Alarm.Information}"/>

                                <ContentPresenter Grid.Row="5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding PopupContent}"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="FontSize"
                                                    Value="{Binding ContentFontSize, RelativeSource={RelativeSource AncestorType={x:Type controls:BasicPopup}}}"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:BasicPopup}}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <Grid Grid.Row="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="{Binding ButtonSpacing, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="Button_Left"
                                            Grid.Column="1"
                                            Width="{TemplateBinding ButtonWidth}"
                                            Style="{DynamicResource BasicPopupButtonStyle}"
                                            Content="{DynamicResource String.Popup.Yes}"
                                            Command="{TemplateBinding Command}"
                                            CommandParameter="{TemplateBinding CmdParBtnLeft}"/>

                                    <Button x:Name="Button_Right"
                                            Grid.Column="3"
                                            Width="{TemplateBinding ButtonWidth}"
                                            Style="{DynamicResource BasicPopupButtonStyle}"
                                            Content="{DynamicResource String.Popup.No}"
                                            Command="{TemplateBinding Command}"
                                            CommandParameter="{TemplateBinding CmdParBtnRight}"/>

                                    <Button x:Name="Button_Single"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            Width="{Binding ButtonWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{DynamicResource BasicPopupButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Content="{DynamicResource String.Popup.OK}"
                                            Command="{TemplateBinding Command}"
                                            CommandParameter="{TemplateBinding CmdParBtnLeft}"
                                            Visibility="Collapsed"/>
                                </Grid>
                                </Grid>
                            </Border>

                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="AlarmType" Value="{x:Static base:AlarmType.INFO}">
                            <Setter TargetName="Button_Left" Property="Background" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Button_Left" Property="BorderBrush" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Button_Left" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                            <Setter TargetName="Button_Single" Property="Background" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Button_Single" Property="BorderBrush" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Button_Single" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                        </Trigger>
                        <Trigger Property="AlarmType" Value="{x:Static base:AlarmType.WARNING}">
                            <Setter TargetName="Border_Accent" Property="Background" Value="{DynamicResource Brush.Warning}"/>
                            <Setter TargetName="Border_Accent" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                            <Setter TargetName="Image_Type" Property="Source" Value="{DynamicResource Icon.Warning}"/>
                            <Setter TargetName="Text_Title" Property="Text" Value="{DynamicResource String.Alarm.Warning}"/>
                            <Setter TargetName="Button_Left" Property="Background" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Button_Left" Property="BorderBrush" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Button_Left" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                            <Setter TargetName="Button_Single" Property="Background" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Button_Single" Property="BorderBrush" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Button_Single" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                        </Trigger>
                        <Trigger Property="AlarmType" Value="{x:Static base:AlarmType.ERROR}">
                            <Setter TargetName="Border_Accent" Property="Background" Value="{DynamicResource Brush.Error}"/>
                            <Setter TargetName="Border_Accent" Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                            <Setter TargetName="Image_Type" Property="Source" Value="{DynamicResource Icon.Error}"/>
                            <Setter TargetName="Text_Title" Property="Text" Value="{DynamicResource String.Alarm.Error}"/>
                            <Setter TargetName="Button_Left" Property="Background" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Button_Left" Property="BorderBrush" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Button_Left" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                            <Setter TargetName="Button_Single" Property="Background" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Button_Single" Property="BorderBrush" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Button_Single" Property="Foreground" Value="{DynamicResource Brush.White}"/>
                        </Trigger>
                        <Trigger Property="IsSingleButton" Value="True">
                            <Setter TargetName="Button_Left" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Button_Right" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Button_Single" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
