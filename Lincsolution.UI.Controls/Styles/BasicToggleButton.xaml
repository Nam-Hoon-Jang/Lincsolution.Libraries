<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">

    <Style TargetType="{x:Type controls:BasicToggleButton}">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.SelectedBackground}"/>
        <Setter Property="UncheckedBackground" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="ThumbBrush" Value="{DynamicResource Brush.IdleForeground}"/>
        <Setter Property="CheckedThumbBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
        <Setter Property="UncheckedThumbBrush" Value="{DynamicResource Brush.IdleForeground}"/>
        <Setter Property="ThumbSize" Value="24"/>
        <Setter Property="ThumbMargin" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BasicToggleButton}">
                    <Border x:Name="Border_Track"
                            Background="{TemplateBinding UncheckedBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Ellipse x:Name="Ellipse_Thumb"
                                 Width="{TemplateBinding ThumbSize}"
                                 Height="{TemplateBinding ThumbSize}"
                                 Margin="{TemplateBinding ThumbMargin}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Fill="{TemplateBinding UncheckedThumbBrush}"
                                 IsHitTestVisible="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Track"
                                    Property="BorderBrush"
                                    Value="{DynamicResource Brush.SelectedForeground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Border_Track"
                                    Property="Background"
                                    Value="{Binding UncheckedBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Ellipse_Thumb"
                                    Property="Fill"
                                    Value="{Binding UncheckedThumbBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Ellipse_Thumb"
                                    Property="HorizontalAlignment"
                                    Value="Left"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border_Track"
                                    Property="Background"
                                    Value="{Binding CheckedBackground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Track"
                                    Property="BorderBrush"
                                    Value="{Binding CheckedThumbBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Ellipse_Thumb"
                                    Property="Fill"
                                    Value="{Binding CheckedThumbBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Ellipse_Thumb"
                                    Property="HorizontalAlignment"
                                    Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
