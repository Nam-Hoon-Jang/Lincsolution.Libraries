<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">

    <Style TargetType="{x:Type controls:EllipseProgressBar}">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="200"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Value" Value="0"/>
        <Setter Property="ProgressThickness" Value="60"/>
        <Setter Property="Background" Value="{DynamicResource Brush.IdleForeground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.MainTheme}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="TextForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="IsTextBindedByValue" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EllipseProgressBar}">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True">
                        <Ellipse x:Name="TrackEllipse"
                                 Width="{TemplateBinding Width}"
                                 Height="{TemplateBinding Height}"
                                 Stroke="{TemplateBinding Background}"
                                 StrokeThickness="{TemplateBinding ProgressThickness}"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="PART_ProgressEllipse"
                                 Width="{TemplateBinding Width}"
                                 Height="{TemplateBinding Height}"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding ProgressThickness}"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="Text_ProgressBar"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding TextForeground, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontFamily="{Binding FontFamily, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontWeight="{Binding FontWeight, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}"
                                   Text="{Binding TextBindedValue, RelativeSource={RelativeSource TemplatedParent}}" TextAlignment="Center" TextWrapping="NoWrap"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>



