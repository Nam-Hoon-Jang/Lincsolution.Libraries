<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls"
                    mc:Ignorable="po">

    <Style TargetType="{x:Type controls:AlarmButton}">
        <Setter Property="Width" Value="88"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsAlarmOn" Value="False"/>
        <Setter Property="IconSize" Value="40"/>
        <Setter Property="IconFill" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="IconStroke" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="IconStrokeThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AlarmButton}">
                    <Grid>
                        <Border x:Name="Border_Button"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ContentPresenter x:Name="Content_Button"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <Viewbox Width="{TemplateBinding IconSize}"
                                 Height="{TemplateBinding IconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Stretch="Uniform">
                            <Canvas Width="28" Height="34">
                                <Path x:Name="Path_BellBody"
                                      IsHitTestVisible="False"
                                      Stretch="None"
                                      Stroke="{TemplateBinding IconStroke}"
                                      StrokeThickness="{TemplateBinding IconStrokeThickness}"
                                      Fill="{TemplateBinding IconFill}"
                                      StrokeMiterLimit="1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="{DynamicResource Geom.BellBody}"/>
                                <Path x:Name="Path_Bell"
                                      Canvas.Right="2"
                                      Canvas.Top="2"
                                      Panel.ZIndex="1"
                                      IsHitTestVisible="False"
                                      Stretch="None"
                                      Stroke="{TemplateBinding IconStroke}"
                                      StrokeThickness="{TemplateBinding IconStrokeThickness}"
                                      Fill="{TemplateBinding IconFill}"
                                      StrokeMiterLimit="1"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="{DynamicResource Geom.Bell}"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsPressed" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border_Button" Property="Background" Value="{DynamicResource Brush.SelectedBackgroundHighOpacity}"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsPressed" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Border_Button" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="2"/>
                        </MultiTrigger>
                        <Trigger Property="IsAlarmOn" Value="True">
                            <Setter TargetName="Path_Bell" Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                        </Trigger>
                        <Trigger Property="IsAlarmOn" Value="False">
                            <Setter TargetName="Path_Bell" Property="Fill" Value="{DynamicResource Brush.MainBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
