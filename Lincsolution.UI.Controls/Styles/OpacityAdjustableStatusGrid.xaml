<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls"
                    xmlns:base="clr-namespace:Lincsolution.UI.Base.Common;assembly=Lincsolution.UI.Base">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Lincsolution.UI.Resources;component/Animations/Storyboards.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:OpacityAdjustableStatusGrid}">
        <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Status" Value="{x:Static base:UiState.IDLE}"/>
        <Style.Triggers>
            <Trigger Property="Status" Value="{x:Static base:UiState.IDLE}">
                <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.BUSY}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusReady_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBusy" Storyboard="{StaticResource Storyboard.Fade.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBusy"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.READY}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusReady_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtReady" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtReady"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.BUILD}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusBuild_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="FadeAtBuild" Storyboard="{StaticResource Storyboard.Fade.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="FadeAtBuild"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.PAUSE}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusBuild_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtPause" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtPause"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.DONE}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusDone_Background}"/>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.STOP}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusError_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtStop" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtStop"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.WARNING}">
                <Setter Property="Background" Value="{DynamicResource Brush.WarningLowOpacity}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtWarning" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtWarning"/>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="Status" Value="{x:Static base:UiState.ERROR}">
                <Setter Property="Background" Value="{DynamicResource Brush.StatusError_Background}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkAtError" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkAtError"/>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
