<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Lincsolution.UI.Controls">
    <Style TargetType="{x:Type controls:TabView}">
        <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TabView}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{TemplateBinding TitleWidth}"/><ColumnDefinition Width="{TemplateBinding ButtonSpacing}"/><ColumnDefinition Width="{TemplateBinding ButtonWidth}"/><ColumnDefinition Width="{TemplateBinding ButtonSpacing}"/><ColumnDefinition Width="{TemplateBinding ButtonWidth}"/><ColumnDefinition Width="{TemplateBinding ButtonSpacing}"/><ColumnDefinition Width="{TemplateBinding ButtonWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding TitleBorderThickness}"><ContentPresenter Content="{TemplateBinding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding TitleFontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/></Border>
                        <Button Grid.Column="2" Content="{TemplateBinding Button1Content}" Command="{TemplateBinding Button1Command}" CommandParameter="{TemplateBinding Button1CommandParameter}" IsEnabled="{TemplateBinding IsButton1Enabled}" Tag="{TemplateBinding UseButton1}"/>
                        <Button Grid.Column="4" Content="{TemplateBinding Button2Content}" Command="{TemplateBinding Button2Command}" CommandParameter="{TemplateBinding Button2CommandParameter}" IsEnabled="{TemplateBinding IsButton2Enabled}" Tag="{TemplateBinding UseButton2}"/>
                        <Button Grid.Column="6" Content="{TemplateBinding Button3Content}" Command="{TemplateBinding Button3Command}" CommandParameter="{TemplateBinding Button3CommandParameter}" IsEnabled="{TemplateBinding IsButton3Enabled}" Tag="{TemplateBinding UseButton3}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
