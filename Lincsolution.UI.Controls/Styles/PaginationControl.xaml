<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">
    <Style TargetType="{x:Type controls:PaginationControl}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PaginationControl}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:BasicButton Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                              Margin="0,0,8,0" Command="{x:Static controls:PaginationControl.PreviousPageCommand}"
                                              Content="&#x276E;" FontSize="{TemplateBinding FontSize}"/>
                        <TextBlock Text="{TemplateBinding CurrentPage}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" MinWidth="24" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="/" Foreground="{TemplateBinding Foreground}" Margin="4,0"
                                   FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding PageCount}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" MinWidth="24" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <controls:BasicButton Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                              Margin="8,0,0,0" Command="{x:Static controls:PaginationControl.NextPageCommand}"
                                              Content="&#x276F;" FontSize="{TemplateBinding FontSize}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
