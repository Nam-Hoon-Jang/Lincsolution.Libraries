<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">
    <Style TargetType="{x:Type controls:ToggleButtonPanel}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="SubjectForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="UnitForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="SubjectBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="UnitBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="CheckedBackground" Value="{DynamicResource Brush.SelectedBackground}"/>
        <Setter Property="UncheckedBackground" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="ThumbBrush" Value="{DynamicResource Brush.IdleForeground}"/>
        <Setter Property="CheckedThumbBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
        <Setter Property="UncheckedThumbBrush" Value="{DynamicResource Brush.IdleForeground}"/>
        <Setter Property="ToggleBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleButtonPanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{TemplateBinding LeftSpace}"/>
                            <ColumnDefinition Width="{TemplateBinding SubjectWidth}"/>
                            <ColumnDefinition Width="{TemplateBinding MidSpace}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{TemplateBinding MidSpace}"/>
                            <ColumnDefinition Width="{TemplateBinding UnitWidth}"/>
                            <ColumnDefinition Width="{TemplateBinding EndSpace}"/>
                        </Grid.ColumnDefinitions>
                        <controls:BasicTextBlock Grid.Column="1"
                            Text="{TemplateBinding SubjectText}" Background="{TemplateBinding SubjectBackground}"
                            Foreground="{TemplateBinding SubjectForeground}" BorderBrush="{TemplateBinding SubjectBorderBrush}"
                            BorderThickness="{TemplateBinding SubjectBorderThickness}" CornerRadius="{TemplateBinding SubjectCornerRadius}"
                            FontFamily="{TemplateBinding SubjectFontFamily}" FontSize="{TemplateBinding SubjectFontSize}"
                            FontWeight="{TemplateBinding SubjectFontWeight}" FontStyle="{TemplateBinding SubjectFontStyle}"
                            Padding="{TemplateBinding SubjectPadding}" TextWrapping="{TemplateBinding SubjectTextWrapping}"
                            TextTrimming="{TemplateBinding SubjectTextTrimming}" TextAlignment="Left"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        <controls:BasicToggleButton Grid.Column="3"
                            Width="{TemplateBinding ToggleWidth}" Height="{TemplateBinding ToggleHeight}"
                            IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            CornerRadius="{TemplateBinding ToggleCornerRadius}" BorderBrush="{TemplateBinding ToggleBorderBrush}"
                            BorderThickness="{TemplateBinding ToggleBorderThickness}" CheckedBackground="{TemplateBinding CheckedBackground}"
                            UncheckedBackground="{TemplateBinding UncheckedBackground}" ThumbBrush="{TemplateBinding ThumbBrush}" CheckedThumbBrush="{TemplateBinding CheckedThumbBrush}"
                            UncheckedThumbBrush="{TemplateBinding UncheckedThumbBrush}"
                            ThumbSize="{TemplateBinding ThumbSize}" ThumbMargin="{TemplateBinding ThumbMargin}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:BasicTextBlock Grid.Column="5"
                            Text="{TemplateBinding UnitText}" Background="{TemplateBinding UnitBackground}"
                            Foreground="{TemplateBinding UnitForeground}" BorderBrush="{TemplateBinding UnitBorderBrush}"
                            BorderThickness="{TemplateBinding UnitBorderThickness}" CornerRadius="{TemplateBinding UnitCornerRadius}"
                            FontFamily="{TemplateBinding UnitFontFamily}" FontSize="{TemplateBinding UnitFontSize}"
                            FontWeight="{TemplateBinding UnitFontWeight}" FontStyle="{TemplateBinding UnitFontStyle}"
                            Padding="{TemplateBinding UnitPadding}" TextWrapping="{TemplateBinding UnitTextWrapping}"
                            TextTrimming="{TemplateBinding UnitTextTrimming}" TextAlignment="Left"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
