<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Lincsolution.UI.Resources;component/Animations/Storyboards.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:EmergencyToggleButton}">
        <Setter Property="Width" Value="176"/>
        <Setter Property="Height" Value="88"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="IconWidth" Value="60"/>
        <Setter Property="IconHeight" Value="60"/>
        <Setter Property="IconMargin" Value="15 0 0 0"/>
        <Setter Property="IdleIcon" Value="{DynamicResource Icon.EmergencyIdle}"/>
        <Setter Property="PressedIcon" Value="{DynamicResource Icon.EmergencyPressed}"/>
        <Setter Property="IdleContent" Value="{DynamicResource String.Emergency.NewLine}"/>
        <Setter Property="PressedContent" Value="{DynamicResource String.Emergency.NewLine}"/>
        <Setter Property="ContentWidth" Value="90"/>
        <Setter Property="ContentHeight" Value="40"/>
        <Setter Property="ContentMargin" Value="5 0 0 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmergencyToggleButton}">
                    <Grid x:Name="Grid_Button"
                          Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          Background="{DynamicResource Brush.MainBackground}">
                        <Border x:Name="Border_CheckedBackground"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{DynamicResource Brush.ErrorPressedLowOpacity}"
                                Opacity="0"/>
                        <Border x:Name="Border_Button"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>

                        <Grid x:Name="Grid_Icon"
                              Width="{TemplateBinding IconWidth}"
                              Height="{TemplateBinding IconHeight}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding IconMargin}"
                              Background="Transparent">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" CenterX="30" CenterY="30"/>
                            </Grid.RenderTransform>

                            <Image x:Name="Image_Idle"
                                   Width="{TemplateBinding IconWidth}"
                                   Height="{TemplateBinding IconHeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Panel.ZIndex="1"
                                   Source="{TemplateBinding IdleIcon}"/>
                            <Image x:Name="Image_Pressed"
                                   Width="{TemplateBinding IconWidth}"
                                   Height="{TemplateBinding IconHeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="{TemplateBinding PressedIcon}"/>
                        </Grid>

                        <TextBlock x:Name="Text_Button"
                                   Width="{TemplateBinding ContentWidth}"
                                   Height="{TemplateBinding ContentHeight}"
                                   Text="{Binding IdleContent, RelativeSource={RelativeSource TemplatedParent}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="{TemplateBinding ContentMargin}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextAlignment="Left"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="ToggleButton.Checked">
                            <BeginStoryboard Storyboard="{StaticResource Storyboard.EmergencyButton.Rotate.Checked}"/>
                        </EventTrigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Text_Button" Property="Text" Value="{Binding PressedContent, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource Brush.ErrorPressed}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkImageAtCheckTrue" Storyboard="{StaticResource Storyboard.EmergencyButton.Blink.IdleImage}"/>
                                <BeginStoryboard x:Name="BlinkBackgroundAtCheckTrue" Storyboard="{StaticResource Storyboard.EmergencyButton.Blink.Background}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkImageAtCheckTrue"/>
                                <StopStoryboard BeginStoryboardName="BlinkBackgroundAtCheckTrue"/>
                            </Trigger.ExitActions>
                        </Trigger>

                        <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                            <BeginStoryboard Storyboard="{StaticResource Storyboard.EmergencyButton.Rotate.Unchecked}"/>
                        </EventTrigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Text_Button" Property="Text" Value="{Binding IdleContent, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Image_Idle" Property="Opacity" Value="1"/>
                            <Setter TargetName="Border_CheckedBackground" Property="Opacity" Value="0"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
