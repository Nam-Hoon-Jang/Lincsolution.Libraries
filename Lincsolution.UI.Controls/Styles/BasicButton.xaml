<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">

    <Style TargetType="{x:Type controls:BasicButton}">
        <Setter Property="Width" Value="88"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource Brush.MainBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="ContentHorizontalAlignment" Value="Center"/>
        <Setter Property="ContentVerticalAlignment" Value="Center"/>
        <Setter Property="ContentMargin" Value="2"/>
        <Setter Property="HighLightBackgroundBrush" Value="{DynamicResource Brush.SelectedBackgroundHighOpacity}"/>
        <Setter Property="HighLightForegroundBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
        <Setter Property="HighLightBorderBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
        <Setter Property="HighLightBorderThickness" Value="2"/>
        <Setter Property="DisabledBackgroundBrush" Value="{DynamicResource Brush.ButtonIdleBackground}"/>
        <Setter Property="DisabledForegroundBrush" Value="{DynamicResource Brush.ButtonIdleForeground}"/>
        <Setter Property="DisabledBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="DisabledBorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BasicButton}">
                    <Border x:Name="Border_Button"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding ContentHorizontalAlignment}"
                                          VerticalAlignment="{TemplateBinding ContentVerticalAlignment}"
                                          Margin="{TemplateBinding ContentMargin}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{Binding HighLightBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="{Binding HighLightBorderThickness, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Foreground" Value="{Binding HighLightForegroundBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border_Button" Property="Background" Value="{Binding HighLightBackgroundBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{Binding DisabledBackgroundBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Foreground" Value="{Binding DisabledForegroundBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Button" Property="BorderBrush" Value="{Binding DisabledBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Border_Button" Property="BorderThickness" Value="{Binding DisabledBorderThickness, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
