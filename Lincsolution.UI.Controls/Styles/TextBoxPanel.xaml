<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">
    <Style TargetType="{x:Type controls:TextBoxPanel}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="SubjectForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="UnitForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="SubjectBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="UnitBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="TextBoxBackground" Value="{DynamicResource Brush.TextBoxIdleBackground}"/>
        <Setter Property="TextBoxForeground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="TextBoxBorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="WatermarkForeground" Value="{DynamicResource Brush.TextBoxIdleForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TextBoxPanel}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{TemplateBinding LeftSpace}"/>
                            <ColumnDefinition Width="{TemplateBinding SubjectWidth}"/>
                            <ColumnDefinition Width="{TemplateBinding MidSpace}"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{TemplateBinding MidSpace}"/>
                            <ColumnDefinition Width="{TemplateBinding UnitWidth}"/>
                            <ColumnDefinition Width="{TemplateBinding EndSpace}"/>
                        </Grid.ColumnDefinitions>
                        <controls:BasicTextBlock Grid.Column="1"
                            Text="{TemplateBinding SubjectText}" Background="{TemplateBinding SubjectBackground}"
                            Foreground="{TemplateBinding SubjectForeground}" BorderBrush="{TemplateBinding SubjectBorderBrush}"
                            BorderThickness="{TemplateBinding SubjectBorderThickness}" CornerRadius="{TemplateBinding SubjectCornerRadius}"
                            FontFamily="{TemplateBinding SubjectFontFamily}" FontSize="{TemplateBinding SubjectFontSize}"
                            FontWeight="{TemplateBinding SubjectFontWeight}" FontStyle="{TemplateBinding SubjectFontStyle}"
                            Padding="{TemplateBinding SubjectPadding}" TextWrapping="{TemplateBinding SubjectTextWrapping}"
                            TextTrimming="{TemplateBinding SubjectTextTrimming}" TextAlignment="Left"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        <controls:ValidationTextBox Grid.Column="3"
                            Width="{TemplateBinding TextBoxWidth}" Height="{TemplateBinding TextBoxHeight}"
                            Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ValidationMode="{TemplateBinding ValidationMode}" Background="{TemplateBinding TextBoxBackground}"
                            Foreground="{TemplateBinding TextBoxForeground}" BorderBrush="{TemplateBinding TextBoxBorderBrush}"
                            BorderThickness="{TemplateBinding TextBoxBorderThickness}" CornerRadius="{TemplateBinding TextBoxCornerRadius}"
                            FontFamily="{TemplateBinding TextBoxFontFamily}" FontSize="{TemplateBinding TextBoxFontSize}"
                            FontWeight="{TemplateBinding TextBoxFontWeight}" FontStyle="{TemplateBinding TextBoxFontStyle}"
                            Padding="{TemplateBinding TextBoxPadding}" Watermark="{TemplateBinding Watermark}"
                            WatermarkFontSize="{TemplateBinding WatermarkFontSize}" WatermarkFontWeight="{TemplateBinding WatermarkFontWeight}"
                            WatermarkFontStyle="{TemplateBinding WatermarkFontStyle}" WatermarkForeground="{TemplateBinding WatermarkForeground}"
                            WatermarkMargin="{TemplateBinding WatermarkMargin}"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <controls:BasicTextBlock Grid.Column="5"
                            Text="{TemplateBinding UnitText}" Background="{TemplateBinding UnitBackground}"
                            Foreground="{TemplateBinding UnitForeground}" BorderBrush="{TemplateBinding UnitBorderBrush}"
                            BorderThickness="{TemplateBinding UnitBorderThickness}" CornerRadius="{TemplateBinding UnitCornerRadius}"
                            FontFamily="{TemplateBinding UnitFontFamily}" FontSize="{TemplateBinding UnitFontSize}"
                            FontWeight="{TemplateBinding UnitFontWeight}" FontStyle="{TemplateBinding UnitFontStyle}"
                            Padding="{TemplateBinding UnitPadding}" TextWrapping="{TemplateBinding UnitTextWrapping}"
                            TextTrimming="{TemplateBinding UnitTextTrimming}" TextAlignment="Left"
                            HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
