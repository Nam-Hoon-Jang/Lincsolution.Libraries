<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls"
                    xmlns:base="clr-namespace:Lincsolution.UI.Base.Common;assembly=Lincsolution.UI.Base">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Lincsolution.UI.Resources;component/Animations/Storyboards.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type controls:StatusLabel}">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Brush.StatusIdle_Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusIdle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusIdle}"/>
        <Setter Property="FontFamily" Value="{StaticResource Inter}"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Tag" Value="{x:Static base:UiState.IDLE}"/>
        <Setter Property="Content" Value="{DynamicResource String.Idle}"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="IconImage" Value="{DynamicResource Icon.Idle}"/>
        <Setter Property="IconSize" Value="15"/>
        <Setter Property="IconLeftPos" Value="8"/>
        <Setter Property="TextBlockLeftPos" Value="50"/>
        <Setter Property="TextBlockWidth" Value="70"/>
        <Setter Property="TextBlockHeight" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusLabel}">
                    <Grid>
                        <Border x:Name="Border_Label"
                                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>
                        <TextBlock x:Name="Text_Label"
                                   Width="{TemplateBinding TextBlockWidth}" Height="{TemplateBinding TextBlockHeight}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                                   Text="{TemplateBinding Content}" TextAlignment="Left"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   FontSize="{TemplateBinding FontSize}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="{Binding TextBlockLeftPos, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <Image x:Name="Image_Label"
                               Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5 0.5"
                               Source="{TemplateBinding IconImage}">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="RotateIf" Angle="0"/>
                                    <TranslateTransform X="{Binding IconLeftPos, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.IDLE}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Idle}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Idle}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusIdle_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusIdle}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                        </Trigger> 
                        <Trigger Property="Tag" Value="{x:Static base:UiState.BUSY}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Busy}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Busy}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FadeAtBusy"
                                                 Storyboard="{StaticResource Storyboard.Fade.Opacity}"/>
                                <BeginStoryboard x:Name="RotateAtBusy"
                                                 Storyboard="{StaticResource Storyboard.Rotate}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FadeAtBusy"/>
                                <StopStoryboard BeginStoryboardName="RotateAtBusy"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.READY}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Ready}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Ready}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusReady}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtReady"
                                                 Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtReady"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.BUILD}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Progressing}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusBuild}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Build}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusBuild_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusBuild}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FadeAtBuild" Storyboard="{StaticResource Storyboard.Fade.Opacity}"/>
                                <BeginStoryboard x:Name="RotateAtBuild" Storyboard="{StaticResource Storyboard.Rotate}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FadeAtBuild"/>
                                <StopStoryboard BeginStoryboardName="RotateAtBuild"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.PAUSE}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Progressing}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusBuild}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Pause}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusBuild_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusBuild}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtPause" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtPause"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.DONE}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Done}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusDone}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Done}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusDone_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusDone}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.STOP}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Stop}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Stop}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusError_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtStop" Storyboard="{StaticResource Storyboard.Blink.3x.Opacity}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtStop"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.WARNING}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Warning}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Warning}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusReady_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="2"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtWarning" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtWarning"/>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Tag" Value="{x:Static base:UiState.ERROR}">
                            <Setter TargetName="Image_Label" Property="Source" Value="{DynamicResource Icon.Error}"/>
                            <Setter TargetName="Text_Label" Property="Foreground" Value="{DynamicResource Brush.StatusError}"/>
                            <Setter TargetName="Text_Label" Property="Text" Value="{DynamicResource String.Error}"/>
                            <Setter TargetName="Border_Label" Property="Background" Value="{DynamicResource Brush.StatusError_Background}"/>
                            <Setter TargetName="Border_Label" Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
                            <Setter TargetName="Border_Label" Property="BorderThickness" Value="2"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="BlinkAtError" Storyboard="{StaticResource Storyboard.Blink.Opacity}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="BlinkAtError"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>
