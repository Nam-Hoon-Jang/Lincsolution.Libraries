<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Lincsolution.UI.Controls">
    <Style TargetType="{x:Type controls:BasicSlider}">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="TickFrequency" Value="10"/>
        <Setter Property="IsSnapToTickEnabled" Value="False"/>
        <Setter Property="TickPlacement" Value="BottomRight"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Background" Value="{DynamicResource Brush.TextBoxIdleBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/>
        <Setter Property="TickBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="IndicatorBrush" Value="{DynamicResource Brush.SelectedForeground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BasicSlider}">
                    <Grid Margin="8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="14"/>
                        </Grid.RowDefinitions>
                        <ContentControl Grid.Row="0" Content="{TemplateBinding Value}"
                                        ContentStringFormat="{TemplateBinding ValueTextFormat}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsValueVisible, RelativeSource={RelativeSource TemplatedParent}}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton IsHitTestVisible="False" Height="{TemplateBinding TrackHeight}"
                                              Background="{TemplateBinding IndicatorBrush}" BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="4" Height="18" Background="{TemplateBinding IndicatorBrush}" IsHitTestVisible="False"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton IsHitTestVisible="False" Height="{TemplateBinding TrackHeight}"
                                              Background="{TemplateBinding Background}" BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <TickBar Grid.Row="2" Placement="Bottom" Fill="{TemplateBinding TickBrush}"
                                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 TickFrequency="{TemplateBinding TickFrequency}" Height="8"/>
                        <TextBlock Grid.Row="2" Text="{TemplateBinding Minimum}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="2" Text="{TemplateBinding Maximum}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,6,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
