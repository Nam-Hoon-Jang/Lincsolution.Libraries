<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Platforms>AnyCPU</Platforms>
	<IsPackable>true</IsPackable>
	<PackageId>Lincsolution.UI.Controls</PackageId>
	<Version>0.1.1</Version>
	<Authors>Lincsolution</Authors>
	<Description>Lincsolution UI Controls Library</Description>
  </PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Lincsolution.UI.Resources\Lincsolution.UI.Resources.csproj" />
		<ProjectReference Include="..\Lincsolution.UI.Base\Lincsolution.UI.Base.csproj" />
		<ProjectReference Include="..\Lincsolution.Core.SourceGenerator\Lincsolution.Core.SourceGenerator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="Popup\" />
	</ItemGroup>
	
</Project>
