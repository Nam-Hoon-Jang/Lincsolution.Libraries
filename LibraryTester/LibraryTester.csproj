<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64;AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lincsolution.Core.Base\Lincsolution.Core.Base.csproj" />
		<ProjectReference Include="..\Lincsolution.Core.Log\Lincsolution.Core.Logger.csproj" />
		<ProjectReference Include="..\Lincsolution.Core.Rendering\Lincsolution.Core.Rendering.csproj" />
		<ProjectReference Include="..\Lincsolution.Core.Telemetry\Lincsolution.Core.Telemetry.csproj" />
		<ProjectReference Include="..\Lincsolution.UI.Base\Lincsolution.UI.Base.csproj" />
		<ProjectReference Include="..\Lincsolution.UI.Viewer\Lincsolution.UI.Viewer.csproj" />
		<ProjectReference Include="..\Lincsolution.UI\Lincsolution.UI.csproj" />
		<ProjectReference Include="..\Lincsolution.UI.Resources\Lincsolution.UI.Resources.csproj" />
		<ProjectReference Include="..\Lincsolution.UI.Controls\Lincsolution.UI.Controls.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="App.cfg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
