<UserControl x:Class="LibraryTester.Views.Dashboard.Controls.ButtonControlTester"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1500">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="12"
                Background="{DynamicResource Brush.MainBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="8,4,8,12"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.ForegroundNormal}"
                           Text="Button Controls"/>
                <ListBox x:Name="ControlList"
                         DisplayMemberPath="Name"
                         SelectionChanged="OnControlSelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="2"
                Padding="24"
                Background="{DynamicResource Brush.MainBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PreviewTitle"
                           Margin="0,0,0,16"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.ForegroundNormal}"/>
                <Grid x:Name="PreviewHost"
                      Grid.Row="1"
                      Background="Transparent"/>
            </Grid>
        </Border>

        <Border Grid.Column="4"
                Background="{DynamicResource Brush.MainBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.ForegroundNormal}"
                               Text="Properties"/>
                    <ComboBox x:Name="TargetSelector"
                              Grid.Column="1"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnTargetSelectionChanged"
                              Visibility="Collapsed"/>
                    <Button x:Name="ResetButton"
                            Grid.Column="3"
                            MinWidth="72"
                            Padding="10,4"
                            Click="OnResetClicked"
                            Content="Reset"/>
                </Grid>
                <ScrollViewer Grid.Row="1"
                              Padding="16,0,16,16"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertyPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
