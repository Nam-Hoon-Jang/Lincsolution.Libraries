<UserControl x:Class="LibraryTester.Views.Dashboard.Controls.TelemetryDbViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="740" Loaded="OnLoaded">
    <UserControl.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.ForegroundNormal}"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,6"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MinColumnWidth" Value="85"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20" Background="{DynamicResource Brush.MainBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Telemetry DB Viewer" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="SQLite 파일을 읽기 전용으로 조회합니다. 화면을 다시 열어도 이전 기록은 파일 목록에서 확인할 수 있습니다." TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1">
            <Button x:Name="OpenButton" Content="DB 파일 열기" Click="OnOpen"/>
            <Button x:Name="RefreshButton" Content="파일 목록 새로고침" Click="OnRefresh"/>
            <Button x:Name="ReloadButton" Content="현재 DB 새로고침" Click="OnReload" IsEnabled="False"/>
            <TextBlock x:Name="ActivityText" Text="파일을 선택하세요." VerticalAlignment="Center" Margin="4,0,0,6" TextWrapping="Wrap"/>
        </WrapPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="최근 테스트 파일 (최대 100개)" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <ListBox x:Name="FilesList" SelectionChanged="OnFileSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="4,6" ToolTip="{Binding Path}">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="PathBox" IsReadOnly="True" Margin="0,0,0,8" AutomationProperties.Name="선택한 DB 경로"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <TextBlock x:Name="SessionText" Text="세션 ID / 시작·종료 시각 / 종료 이유 / 저장 건수" TextWrapping="Wrap"/>
                </Border>
                <WrapPanel Grid.Row="2" x:Name="FilterPanel" IsEnabled="False">
                    <TextBlock Text="채널" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <ComboBox x:Name="ChannelBox" DisplayMemberPath="Label" Width="170" Margin="0,0,12,8" AutomationProperties.Name="조회 채널"/>
                    <TextBlock Text="경과 초" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <TextBox x:Name="FromBox" Text="0" Width="65" Margin="0,0,4,8" AutomationProperties.Name="시작 경과 초"/>
                    <TextBlock Text="~" VerticalAlignment="Center" Margin="0,0,4,8"/>
                    <TextBox x:Name="ToBox" Width="65" Margin="0,0,8,8" ToolTip="비워두면 끝까지 조회" AutomationProperties.Name="종료 경과 초"/>
                    <Button Content="조회 적용" Click="OnApply"/>
                </WrapPanel>
                <TabControl x:Name="DataTabs" SelectedIndex="0" Grid.Row="3" SelectionChanged="OnDataTabChanged">
                    <TabItem Header="센서값"><DataGrid x:Name="SamplesGrid"/></TabItem>
                    <TabItem Header="이벤트"><DataGrid x:Name="EventsGrid"/></TabItem>
                    <TabItem Header="채널 정의"><DataGrid x:Name="ChannelsGrid"/></TabItem>
                </TabControl>
                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                    <WrapPanel>
                        <Button x:Name="PreviousButton" Content="이전" Click="OnPrevious" IsEnabled="False"/>
                        <Button x:Name="NextButton" Content="다음" Click="OnNext" IsEnabled="False"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="4,0,0,6"/>
                    </WrapPanel>
                    <TextBlock Text="한 페이지 최대 200행 · 값은 채널 정밀도로 복원 · NULL은 ‘값 없음’ · 이벤트는 채널 필터 제외"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
