<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.White" Color="{DynamicResource Color.White}"/>
    <SolidColorBrush x:Key="Brush.Black" Color="{DynamicResource Color.Black}"/>
    <SolidColorBrush x:Key="Brush.MainBackground" Color="{DynamicResource Color.MainBackground}"/>
    <SolidColorBrush x:Key="Brush.MainTheme" Color="{DynamicResource Color.MainTheme}"/>
    <SolidColorBrush x:Key="Brush.MainThemeLowOpacity" Color="{DynamicResource Color.MainTheme}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.ForegroundNormal" Color="{DynamicResource Color.ForegroundNormal}"/>
    <SolidColorBrush x:Key="Brush.ForegroundNormalReverse" Color="{DynamicResource Color.ForegroundNormalReverse}"/>
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="{DynamicResource Color.SelectedBackground}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Brush.SelectedBackgroundHighOpacity" Color="{DynamicResource Color.SelectedBackground}" Opacity="0.7"/>
    <SolidColorBrush x:Key="Brush.SelectedForeground" Color="{DynamicResource Color.SelectedBackground}"/>
    <SolidColorBrush x:Key="Brush.ButtonIdleBackground" Color="{DynamicResource Color.ButtonIdleBackground}"/>
    <SolidColorBrush x:Key="Brush.ButtonIdleForeground" Color="{DynamicResource Color.ButtonIdleForeground}"/>
    <SolidColorBrush x:Key="Brush.ButtonPressedBackground" Color="{DynamicResource Color.ButtonPressedBackground}"/>
    <SolidColorBrush x:Key="Brush.IdleBackground" Color="{DynamicResource Color.IdleBackground}"/>
    <SolidColorBrush x:Key="Brush.IdleForeground" Color="{DynamicResource Color.IdleForeground}"/>
    <SolidColorBrush x:Key="Brush.TextBoxIdleBackground" Color="{DynamicResource Color.TextBoxIdleBackground}"/>
    <SolidColorBrush x:Key="Brush.TextBoxIdleForeground" Color="{DynamicResource Color.TextBoxIdleForeground}" Opacity="0.5"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningLowOpacity" Color="{DynamicResource Color.Warning}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{DynamicResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.ErrorLowOpacity" Color="{DynamicResource Color.Error}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Brush.ErrorPressed" Color="{DynamicResource Color.ErrorPressed}"/>
    <SolidColorBrush x:Key="Brush.ErrorPressedLowOpacity" Color="{DynamicResource Color.ErrorPressed}" Opacity="0.2"/>
    <SolidColorBrush x:Key="Brush.StatusIdle" Color="{DynamicResource Color.StatusIdle}"/>
    <SolidColorBrush x:Key="Brush.StatusReady" Color="{DynamicResource Color.StatusReady}"/>
    <SolidColorBrush x:Key="Brush.StatusBuild" Color="{DynamicResource Color.StatusBuild}"/>
    <SolidColorBrush x:Key="Brush.StatusDone" Color="{DynamicResource Color.StatusDone}"/>
    <SolidColorBrush x:Key="Brush.StatusError" Color="{DynamicResource Color.StatusError}"/>
    <SolidColorBrush x:Key="Brush.StatusIdle_Background" Color="{DynamicResource Color.StatusIdleBackground}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Brush.StatusReady_Background" Color="{DynamicResource Color.StatusReadyBackground}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Brush.StatusBuild_Background" Color="{DynamicResource Color.StatusBuildBackground}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Brush.StatusDone_Background" Color="{DynamicResource Color.StatusDoneBackground}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Brush.StatusError_Background" Color="{DynamicResource Color.StatusErrorBackground}" Opacity="0.3"/>
    <SolidColorBrush x:Key="Brush.IconStatusIdle" Color="{DynamicResource Color.IconStatusIdle}"/>
    <SolidColorBrush x:Key="Brush.IconStatusReady" Color="{DynamicResource Color.IconStatusReady}"/>
    <SolidColorBrush x:Key="Brush.IconStatusError" Color="{DynamicResource Color.IconStatusError}"/>
    <SolidColorBrush x:Key="Brush.PopupBackground" Color="{DynamicResource Color.TextBoxIdleForeground}" Opacity="0.5"/>

</ResourceDictionary>
