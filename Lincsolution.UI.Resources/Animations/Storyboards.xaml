<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 불투명도를 1.0 → 0.5 → 1.0으로 반복 전환한다. -->
    <Storyboard x:Key="Storyboard.Blink.Opacity"
                RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 불투명도 점멸을 3회 실행한 뒤 종료한다. -->
    <Storyboard x:Key="Storyboard.Blink.3x.Opacity"
                RepeatBehavior="3x">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.5"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="1.0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 불투명도를 0.5와 1.0 사이에서 부드럽게 반복 전환한다. -->
    <Storyboard x:Key="Storyboard.Fade.Opacity"
                RepeatBehavior="Forever"
                AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.5"
                         To="1"
                         Duration="0:0:1"/>
    </Storyboard>

    <!-- ControlTemplate 안의 RotateIf RotateTransform을 계속 회전시킨다. -->
    <Storyboard x:Key="Storyboard.Rotate"
                RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="RotateIf"
                         Storyboard.TargetProperty="Angle"
                         From="0"
                         To="360"
                         Duration="0:0:1"/>
    </Storyboard>

    <Storyboard x:Key="Storyboard.Rotate180">
        <DoubleAnimation Storyboard.TargetName="RotateIcon"
                         Storyboard.TargetProperty="Angle"
                         From="0"
                         To="180"
                         Duration="0:0:0.2"/>
    </Storyboard>

    <Storyboard x:Key="Storyboard.Rotate180.Reverse">
        <DoubleAnimation Storyboard.TargetName="RotateIcon"
                         Storyboard.TargetProperty="Angle"
                         From="180"
                         To="0"
                         Duration="0:0:0.2"/>
    </Storyboard>

    <Storyboard x:Key="Storyboard.EmergencyButton.Rotate.Checked">
        <DoubleAnimation Storyboard.TargetName="Grid_Icon"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0"
                         To="90"
                         Duration="0:0:0.25"/>
    </Storyboard>

    <Storyboard x:Key="Storyboard.EmergencyButton.Rotate.Unchecked">
        <DoubleAnimation Storyboard.TargetName="Grid_Icon"
                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="90"
                         To="0"
                         Duration="0:0:0.25"/>
    </Storyboard>

    <Storyboard x:Key="Storyboard.EmergencyButton.Blink.IdleImage"
                RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Image_Idle"
                                       Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="Storyboard.EmergencyButton.Blink.Background"
                RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Border_CheckedBackground"
                                       Storyboard.TargetProperty="Opacity">
            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 체크 표시를 0.5배에서 1.2배로 확대한 뒤 원래 크기로 되돌립니다. -->
    <Storyboard x:Key="Storyboard.Poping">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandIf"
                                       Storyboard.TargetProperty="ScaleX">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ExpandIf"
                                       Storyboard.TargetProperty="ScaleY">
            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.2"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
</ResourceDictionary>
