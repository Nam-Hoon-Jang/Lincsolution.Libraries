<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	<ImplicitUsings>disable</ImplicitUsings>
	<Nullable>disable</Nullable>
	<LangVersion>7.3</LangVersion>
	<Platforms>AnyCPU</Platforms>
	<AssemblyName>Lincsolution.Core.SourceGenerator</AssemblyName>
	<RootNamespace>Lincsolution.Core.SourceGenerator</RootNamespace>
	<IsPackable>true</IsPackable>
	<PackageId>Lincsolution.Core.SourceGenerator</PackageId>
	<Version>0.1.1</Version>
	<Authors>Lincsolution</Authors>
	<Description>Lincsolution Core Source Generator Library</Description>
	<IsRoslynComponent>true</IsRoslynComponent>
	<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" PrivateAssets="all"/>
  </ItemGroup>

</Project>
